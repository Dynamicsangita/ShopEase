<%@ page language="java" contentType="text/html; charset=UTF-8"
pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sales Report | ShopEase Admin</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
<style>
*{box-sizing:border-box;margin:0;padding:0;font-family:Poppins,Arial,sans-serif}
body{display:flex;min-height:100vh;background:linear-gradient(135deg,#eef4ff,#f8fafc 55%,#ecfdf5);color:#1e293b}
.sidebar{position:fixed;width:256px;height:100vh;padding:24px 14px;background:#111827;color:white;box-shadow:10px 0 30px rgba(15,23,42,.12)}
.sidebar h2{margin:0 10px 34px;font-size:1.15rem}.sidebar h2:before{content:'🛒';margin-right:8px}.sidebar a{display:block;margin:4px 0;padding:13px 16px;border-radius:12px;color:white;text-decoration:none;font-size:.88rem}.sidebar a:hover,.sidebar a.active{background:#4338ca}.sidebar a i{width:22px;margin-right:8px;color:#a7f3d0}
.main{width:100%;margin-left:256px;padding:34px}.container{width:100%;max-width:1180px;margin:0 auto}.header{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:24px}.header h1{font-size:1.8rem;color:#111827}.header p{margin-top:5px;color:#64748b;font-size:.85rem}.period{padding:10px 12px;border:1px solid #dbe5f2;border-radius:10px;background:white;color:#475569;font:inherit;font-size:.8rem}
.cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-bottom:20px}.card{padding:21px;border:1px solid rgba(148,163,184,.2);border-radius:18px;background:white;box-shadow:0 14px 28px rgba(15,23,42,.06)}.card i{display:grid;place-items:center;width:42px;height:42px;margin-bottom:15px;border-radius:13px;background:#ede9fe;color:#7c3aed}.card h2{margin-bottom:4px;font-size:1.4rem;color:#111827}.card p{color:#64748b;font-size:.8rem}.trend{margin-top:8px;color:#15803d;font-size:.7rem;font-weight:700}
.report-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:18px;margin-bottom:20px}.panel{padding:22px;border:1px solid rgba(148,163,184,.2);border-radius:18px;background:white;box-shadow:0 14px 28px rgba(15,23,42,.06)}.panel-heading{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.panel h2{font-size:1.05rem}.panel-heading span{color:#64748b;font-size:.72rem}
.month-row{display:grid;grid-template-columns:78px 1fr 90px;align-items:center;gap:12px;margin:15px 0;font-size:.78rem}.month-row strong{font-size:.76rem}.bar{height:9px;overflow:hidden;border-radius:999px;background:#eef2ff}.bar span{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,#7c3aed,#2dd4bf)}
.category-list{display:grid;gap:13px}.category-row{display:grid;grid-template-columns:1fr auto;gap:8px;font-size:.78rem}.category-row div{display:flex;justify-content:space-between;gap:10px}.category-row small{color:#64748b}.category-bar{height:7px;margin-top:6px;border-radius:999px;background:#f1f5f9}.category-bar span{display:block;height:100%;border-radius:inherit;background:#0f766e}
table{width:100%;border-collapse:collapse;overflow:hidden;border-radius:18px;background:white;box-shadow:0 14px 28px rgba(15,23,42,.06)}th{padding:14px;background:#1e293b;color:white;font-size:.75rem;letter-spacing:.04em;text-align:left;text-transform:uppercase}td{padding:14px;border-bottom:1px solid #e2e8f0;color:#475569;font-size:.84rem}td:first-child{color:#111827;font-weight:700}.top-badge{padding:5px 9px;border-radius:999px;background:#fef3c7;color:#a16207;font-size:.7rem;font-weight:700}.back{display:inline-flex;gap:7px;margin-top:18px;color:#4f46e5;font-weight:700;text-decoration:none}
@media(max-width:1000px){.cards{grid-template-columns:repeat(2,minmax(0,1fr))}.report-grid{grid-template-columns:1fr}}
@media(max-width:800px){body{display:block}.sidebar{position:static;width:100%;height:auto;padding:16px}.sidebar h2{text-align:center;margin:0 8px 12px}.sidebar a{display:inline-block;padding:9px 10px;font-size:.74rem}.main{margin:0;padding:20px 14px}.header{align-items:flex-start;flex-direction:column;gap:12px}.cards{grid-template-columns:1fr 1fr}.month-row{grid-template-columns:60px 1fr 72px}table{display:block;overflow-x:auto;white-space:nowrap}}
</style>
</head>
<body>
<aside class="sidebar"><h2>ShopEase Admin</h2><a href="admin-dashboard.jsp"><i class="fa-solid fa-house"></i> Dashboard</a><a href="add-product.jsp"><i class="fa-solid fa-plus"></i> Add Product</a><a href="manage-products.jsp"><i class="fa-solid fa-box"></i> Products</a><a href="manage-orders.jsp"><i class="fa-solid fa-cart-shopping"></i> Orders</a><a href="manage-users.jsp"><i class="fa-solid fa-users"></i> Users</a><a class="active" href="sales-report.jsp"><i class="fa-solid fa-chart-line"></i> Sales Report</a></aside>
<main class="main"><div class="container"><div class="header"><div><h1>Sales Report</h1><p>Track revenue, orders and product performance.</p></div><select class="period"><option>Last 6 months</option><option>This year</option><option>Last year</option></select></div>
<div class="cards"><div class="card"><i class="fa-solid fa-indian-rupee-sign"></i><h2>₹12,50,000</h2><p>Total revenue</p><div class="trend">+18.4% this period</div></div><div class="card"><i class="fa-solid fa-cart-shopping"></i><h2>650</h2><p>Total orders</p><div class="trend">+12.8% this period</div></div><div class="card"><i class="fa-solid fa-users"></i><h2>320</h2><p>Total customers</p><div class="trend">+9.6% this period</div></div><div class="card"><i class="fa-solid fa-box"></i><h2>210</h2><p>Products sold</p><div class="trend">+15.2% this period</div></div></div>
<div class="report-grid"><section class="panel"><div class="panel-heading"><h2>Monthly performance</h2><span>Revenue by month</span></div><div class="month-row"><strong>January</strong><div class="bar"><span style="width:54%"></span></div><b>₹1,45,000</b></div><div class="month-row"><strong>February</strong><div class="bar"><span style="width:68%"></span></div><b>₹1,80,000</b></div><div class="month-row"><strong>March</strong><div class="bar"><span style="width:79%"></span></div><b>₹2,10,000</b></div><div class="month-row"><strong>April</strong><div class="bar"><span style="width:100%"></span></div><b>₹2,65,000</b></div></section><section class="panel"><div class="panel-heading"><h2>Category mix</h2><span>Sales share</span></div><div class="category-list"><div class="category-row"><div><strong>Mobiles</strong><small>42%</small></div><div></div><div class="category-bar"><span style="width:42%"></span></div></div><div class="category-row"><div><strong>Laptops</strong><small>26%</small></div><div></div><div class="category-bar"><span style="width:26%"></span></div></div><div class="category-row"><div><strong>Accessories</strong><small>18%</small></div><div></div><div class="category-bar"><span style="width:18%"></span></div></div><div class="category-row"><div><strong>Fashion & beauty</strong><small>14%</small></div><div></div><div class="category-bar"><span style="width:14%"></span></div></div></div></section></div>
<section class="panel"><div class="panel-heading"><h2>Top products</h2><span>Best performers</span></div><table><thead><tr><th>Product</th><th>Category</th><th>Units sold</th><th>Revenue</th><th>Performance</th></tr></thead><tbody><tr><td>iPhone 16 Pro</td><td>Mobiles</td><td>96</td><td>₹1,24,79,904</td><td><span class="top-badge">Top seller</span></td></tr><tr><td>HP Laptop</td><td>Laptops</td><td>48</td><td>₹28,79,952</td><td><span class="top-badge">Growing</span></td></tr><tr><td>Smart Watch Pro</td><td>Accessories</td><td>72</td><td>₹3,59,928</td><td><span class="top-badge">Popular</span></td></tr></tbody></table></section><a href="admin-dashboard.jsp" class="back"><i class="fa-solid fa-arrow-left"></i> Back to Dashboard</a></div></main>
</body>
</html>
