pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Add Product | ShopEase Admin</title><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"><style>
*{box-sizing:border-box;margin:0;padding:0;font-family:Poppins,Arial,sans-serif}body{display:flex;min-height:100vh;background:linear-gradient(135deg,#eef4ff,#f8fafc 55%,#ecfdf5);color:#1e293b}.sidebar{position:fixed;width:256px;height:100vh;padding:24px 14px;background:#111827;color:white}.sidebar h2{margin:0 10px 34px;font-size:1.15rem}.sidebar h2:before{content:'🛒';margin-right:8px}.sidebar a{display:block;margin:4px 0;padding:13px 16px;border-radius:12px;color:white;text-decoration:none;font-size:.88rem}.sidebar a:hover,.sidebar a.active{background:#4338ca}.sidebar a i{width:22px;margin-right:8px;color:#a7f3d0}.main{width:100%;margin-left:256px;padding:34px}.container{max-width:1050px;margin:auto}.form-header{margin-bottom:22px}.form-header h1{font-size:1.8rem;color:#111827}.form-header p{margin-top:5px;color:#64748b;font-size:.85rem}.form-layout{display:grid;grid-template-columns:1fr 280px;gap:20px}.form-card,.preview-card{padding:26px;border:1px solid rgba(148,163,184,.25);border-radius:22px;background:rgba(255,255,255,.9);box-shadow:0 14px 28px rgba(15,23,42,.06)}.form-card h2,.preview-card h2{font-size:1.05rem;margin-bottom:18px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.field{display:grid;gap:7px}.field.full{grid-column:1/-1}.field label{font-size:.8rem;font-weight:700}.field input,.field select,.field textarea{width:100%;padding:11px 12px;border:1px solid #dbe5f2;border-radius:10px;background:#fbfdff;font:inherit;font-size:.84rem;outline:none}.field textarea{resize:vertical}.field input:focus,.field select:focus,.field textarea:focus{border-color:#7c3aed;box-shadow:0 0 0 3px rgba(124,58,237,.12)}.form-actions{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:22px}.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:11px 16px;border:0;border-radius:10px;background:linear-gradient(135deg,#7c3aed,#4f46e5);color:white;font:inherit;font-size:.82rem;font-weight:700;cursor:pointer}.back{color:#4f46e5;font-size:.82rem;font-weight:700;text-decoration:none}.image-preview{display:grid;place-items:center;height:190px;margin-bottom:14px;padding:16px;border-radius:16px;background:linear-gradient(135deg,#eef4ff,#f0fdfa)}.image-preview img{width:100%;height:100%;object-fit:contain}.preview-card p{color:#64748b;font-size:.76rem;line-height:1.5}.message{display:none;margin-top:14px;padding:10px;border-radius:9px;font-size:.78rem}.message.success{display:block;background:#dcfce7;color:#166534}@media(max-width:850px){body{display:block}.sidebar{position:static;width:100%;height:auto;padding:16px}.sidebar h2{text-align:center;margin:0 8px 12px}.sidebar a{display:inline-block;padding:9px 10px;font-size:.74rem}.main{margin:0;padding:20px 14px}.form-layout{grid-template-columns:1fr}.preview-card{order:-1}}@media(max-width:550px){.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.form-actions{align-items:stretch;flex-direction:column-reverse}.btn,.back{width:100%;text-align:center}}
+</style></head><body>
+<aside class="sidebar"><h2>ShopEase Admin</h2><a href="admin-dashboard.jsp"><i class="fa-solid fa-house"></i> Dashboard</a><a class="active" href="add-product.jsp"><i class="fa-solid fa-plus"></i> Add Product</a><a href="manage-products.jsp"><i class="fa-solid fa-box"></i> Products</a><a href="manage-orders.jsp"><i class="fa-solid fa-cart-shopping"></i> Orders</a><a href="manage-users.jsp"><i class="fa-solid fa-users"></i> Users</a><a href="sales-report.jsp"><i class="fa-solid fa-chart-line"></i> Sales Report</a></aside>
+<main class="main"><div class="container"><div class="form-header"><span style="color:#7c3aed;font-size:.75rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase">Catalog management</span><h1>Add new product</h1><p>Bring a new product into the ShopEase catalog.</p></div><form id="product-form" class="form-layout"><div class="form-card"><h2>Product information</h2><div class="form-grid"><div class="field full"><label for="name">Product name</label><input id="name" type="text" placeholder="e.g. Premium Laptop" required></div><div class="field"><label for="category">Category</label><select id="category"><option>Mobiles</option><option>Laptops</option><option>Fashion</option><option>Shoes</option><option>Electronics</option><option>Beauty</option></select></div><div class="field"><label for="brand">Brand</label><input id="brand" type="text" placeholder="Brand name" required></div><div class="field"><label for="price">Price (₹)</label><input id="price" type="number" min="1" placeholder="Product price" required></div><div class="field"><label for="stock">Stock quantity</label><input id="stock" type="number" min="0" placeholder="Available stock" required></div><div class="field"><label for="discount">Discount (%)</label><input id="discount" type="number" min="0" max="100" placeholder="0"></div><div class="field full"><label for="description">Description</label><textarea id="description" rows="5" placeholder="Describe the product, its features and value."></textarea></div><div class="field full"><label for="image">Product image</label><input id="image" type="file" accept="image/*"></div></div><div class="form-actions"><a class="back" href="manage-products.jsp"><i class="fa-solid fa-arrow-left"></i> Back to products</a><button class="btn" type="submit"><i class="fa-solid fa-plus"></i> Add product</button></div><p class="message" id="message">Product added successfully. It is ready for catalog review.</p></div><aside class="preview-card"><h2>Image preview</h2><div class="image-preview"><img id="preview" src="../images/iphone.jpg" alt="Product preview"></div><p>Choose a clear product image with a simple background for the best storefront presentation.</p></aside></form></div></main>
+<script>document.getElementById('image').addEventListener('change',event=>{const file=event.target.files[0];if(file)document.getElementById('preview').src=URL.createObjectURL(file)});document.getElementById('product-form').addEventListener('submit',event=>{event.preventDefault();document.getElementById('message').className='message success';});</script></body></html>
